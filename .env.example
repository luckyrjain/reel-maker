DATABASE_URL=postgresql://reelmaker:reelmaker@localhost:5432/reelmaker
REDIS_URL=redis://localhost:6379/0

# LLM — main generation model (local Ollama)
# Recommended: qwen3:14b. Fallback: llama3.1:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b

# NVIDIA NIM — enrichment + quality-judge calls (hosted, faster, higher quality)
# Get a free key at build.nvidia.com. Leave blank to use local LLM_ENRICHMENT_MODEL instead.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ENRICHMENT_MODEL=nvidia/nemotron-3-super-120b-a12b
# Set USE_NVIDIA_FOR_GENERATION=true to route main guide generation through NVIDIA NIM.
# Produces higher quality guides; uses more API credits.
NVIDIA_GENERATION_MODEL=nvidia/nemotron-3-super-120b-a12b
USE_NVIDIA_FOR_GENERATION=false

# Local fallback for enrichment when NVIDIA_API_KEY is not set
LLM_ENRICHMENT_MODEL=qwen3:14b

# TTS — "edge" (pip install edge-tts), "kokoro" (Python <3.13), or "silent" (no audio)
TTS_PROVIDER=edge

ASSET_STORE_DIR=./data/assets
VIDEO_STORE_DIR=./data/videos

# Required for stock footage (free at pexels.com/api)
PEXELS_API_KEY=
# Optional alternative footage source
PIXABAY_API_KEY=
# HuggingFace Inference API — used to generate custom images when Pexels/Wikipedia find nothing
HUGGINGFACE_API_KEY=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HUGGINGFACE_VIDEO_MODEL=Lightricks/LTX-Video

# Fernet key encrypting credentials.token_blob at rest. Leave blank in dev
# (tokens stored as plaintext with a warning). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Hard ceiling on paid (NVIDIA NIM) LLM calls per reel — stops a stuck retry
# loop from running up an unbounded bill.
MAX_PAID_LLM_CALLS_PER_REEL=20

# Cost estimation for StageEvent.cost_usd — USD per 1M tokens for NVIDIA NIM
# calls. Both default to 0 (cost tracking inert) until set from your actual
# NVIDIA billing plan — rates vary by model/plan and we don't guess a number.
NVIDIA_PRICE_PER_1M_INPUT_TOKENS=0.0
NVIDIA_PRICE_PER_1M_OUTPUT_TOKENS=0.0

# Publicly reachable base URL for this server (must be real HTTPS, not
# localhost, for Instagram publishing — see PUBLIC_BASE_URL notes below).
# Used to build OAuth redirect_uris, which must match a URI registered with
# each provider's app.
PUBLIC_BASE_URL=http://localhost:8000

# OAuth — YouTube Data API. Register an app at console.cloud.google.com,
# enable the YouTube Data API v3, and add
# {PUBLIC_BASE_URL}/api/credentials/youtube/callback as an authorized
# redirect URI.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# OAuth — Instagram publishing via the Meta Graph API. Register an app at
# developers.facebook.com; requires a Facebook Page linked to an Instagram
# Business/Creator account, and add
# {PUBLIC_BASE_URL}/api/credentials/instagram/callback as a valid OAuth
# redirect URI. Instagram fetches the rendered video directly from this
# server, so PUBLIC_BASE_URL must be a real public HTTPS address for
# Instagram publishing to work — localhost/NAT alone will not work.
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=
