DATABASE_URL=postgresql://reelmaker:reelmaker@localhost:5432/reelmaker
REDIS_URL=redis://localhost:6379/0

# LLM — main generation model (local Ollama)
# Recommended: qwen3:14b. Fallback: llama3.1:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b

# NVIDIA NIM — enrichment + quality-judge calls (hosted, faster, higher quality)
# Get a free key at build.nvidia.com. Leave blank to use local LLM_ENRICHMENT_MODEL instead.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ENRICHMENT_MODEL=qwen/qwen3-next-80b-a3b-instruct
# Set USE_NVIDIA_FOR_GENERATION=true to route main guide generation through NVIDIA NIM.
# Produces higher quality guides; uses more API credits.
NVIDIA_GENERATION_MODEL=qwen/qwen3-next-80b-a3b-instruct
USE_NVIDIA_FOR_GENERATION=false

# Local fallback for enrichment when NVIDIA_API_KEY is not set
LLM_ENRICHMENT_MODEL=qwen3:14b

# TTS — set to "kokoro" if pip install .[tts] is done, otherwise "silent"
TTS_PROVIDER=silent

ASSET_STORE_DIR=./data/assets
VIDEO_STORE_DIR=./data/videos

# Required for stock footage (free at pexels.com/api)
PEXELS_API_KEY=
# Optional alternative footage source
PIXABAY_API_KEY=
# HuggingFace Inference API — used to generate custom images when Pexels/Wikipedia find nothing
HUGGINGFACE_API_KEY=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HUGGINGFACE_VIDEO_MODEL=Lightricks/LTX-Video
